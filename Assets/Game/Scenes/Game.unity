  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 27
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.3
  m_Text: "[move]  -  move  (hold [walk] to walk slowly near edges)\r\n[jump]  - 
    jump  (hold longer to jump higher)\r\n[whip]  -  blade;  while holding something:
    throw it  ([up] + [whip] throws high)\r\n[down] + [whip]  -  pick up an item
    / put the held item down\r\n[use]  -  use the equipped GEAR:  bombs ([down] +
    [use] places, [up] + [use] throws high)\r\n         or rope (thrown up, hooks
    onto a ceiling or wall; [down] + [use] at a ledge drops it)\r\nHold [gear]  - 
    GEAR WHEEL: the game freezes, [left] [right] choose, release to equip  (tap [gear]:
    back to the previous gear)\r\n[enter]  or  [up]  -  enter a door, buy a shop
    item\r\n[up] / [down]  -  climb ladders and ropes;  [down]  -  crouch, crawl
    off a ledge to hang\r\nLedges are grabbed automatically when you fall past them: 
    [up] or [jump] climbs, [down] lets go\r\n[down] + [jump]  -  drop through a wooden
    platform;  hold [up] / [down] standing still  -  look\r\n[inventory]  -  equipment:
    wear or take off what you own (boots, coat, charms...)\r\n[pause]  -  pause         
    F11  -  fullscreen\r\nThe buttons shown follow the device you used last: keyboard
    or gamepad."
