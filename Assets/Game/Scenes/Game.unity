  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 27
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.1
  m_Text: "Arrow keys  -  move  (hold SHIFT to walk slowly near edges)\r\nZ  or 
    SPACE  -  jump  (hold longer to jump higher)\r\nX  -  whip;  while holding something:
    throw it  (UP + X throws high)\r\nDOWN + X  -  pick up an item / put the held
    item down\r\nC  -  use the equipped GEAR:  bombs (DOWN + C places, UP + C throws
    high)\r\n         or rope (thrown up, hooks onto a ceiling or wall; DOWN + C
    at a ledge drops it)\r\nHold D  -  GEAR WHEEL: the game freezes, LEFT / RIGHT
    choose, release to equip  (tap D: swap back to the previous gear)\r\nA  or  UP 
    -  enter a door, buy a shop item\r\nUP / DOWN  -  climb ladders and ropes;  DOWN 
    -  crouch, crawl off a ledge to hang\r\nLedges are grabbed automatically when
    you fall past them:  UP or JUMP climbs, DOWN lets go\r\nDOWN + JUMP  -  drop
    through a wooden platform;  hold UP / DOWN standing still  -  look\r\nESC  - 
    pause          F11  -  fullscreen\r\nGamepad: stick / d-pad move, A jump, X whip,
    B use gear, hold R1 gear wheel (stick left/right), Y enter/buy, LT walk"
