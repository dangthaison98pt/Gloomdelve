  m_Script: {fileID: 11500000, guid: dac625fd77b25f24894b61f0fa674848, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Gloomdelve.LoadingScreen
  cover: {fileID: 441289611}
  group: {fileID: 441289613}
  tip: {fileID: 220573003}
  loadingText: {fileID: 924754489}
  fill: {fileID: 564264724}
  fillWidth: 600
  minTime: 1.6
  tips:
  - Bombs open walls. They open you just as easily.
  - A rope reaches where a jump cannot.
  - Hold [gear] to choose what you carry in your hand.
  - Shopkeepers remember a thief for the rest of the run.
  - Stay too long in one level and something comes looking for you.
  - Every boss gives itself away just before it strikes.
  - Boots, coats and charms from the shops make a hard place easier - none of them
    is needed.
  - Hanging from a ledge is a good place to think.
